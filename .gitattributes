# ═══════════════════════════════════════════════════════════════════════
#  پایانِ خط — چرا این فایل وجود دارد
#
#  ⚠️ یافته‌ی واقعیِ ۲۰۲۶-۰۸-۲۰ (P0، با آزمونِ تجربی نه حدس):
#  پنج شل‌اسکریپت با شبنگِ `#!/bin/sh` که به CRLF ذخیره شده بودند، روی
#  لینوکس اصلاً اجرا نمی‌شوند — کرنل دنبالِ مفسری به نامِ `/bin/sh\r`
#  می‌گردد که وجود ندارد:
#
#      $ ./crlf-test.sh
#      cannot execute: required file not found      (exit 127)
#
#  و `api/Dockerfile` دقیقاً همین را اجرا می‌کند:
#      ENTRYPOINT ["dumb-init", "--"]
#      CMD ["/docker-entrypoint.sh"]
#  یعنی کانتینرِ API با آن وضع بالا نمی‌آمد. طبقِ تاریخچه‌ی git، این فایل‌ها
#  از همان کامیتِ اول (۲۰۲۶-۰۷-۲۹) CRLF بوده‌اند.
#
#  مشکلِ دومِ همین ریشه: ریپو مختلط بود (۲۶۴ فایل CRLF، ۵۳۱ فایل LF) و هر
#  ویرایشی که فایل را بازنویسی می‌کرد، صدها خطِ تغییرِ ساختگی در diff تولید
#  می‌کرد. در PR #37 همین ~۲۶۰۰ خط نویز ساخت و بازبینی را عملاً ناممکن کرد.
#
#  از این‌جا به بعد همه‌چیز در مخزن با LF ذخیره می‌شود. هیچ فایلِ ویندوزی
#  (bat/cmd/ps1) در این ریپو نیست، پس استثنایی لازم نبود — چک شد.
# ═══════════════════════════════════════════════════════════════════════

# پیش‌فرض: هر فایلِ متنی در مخزن با LF ذخیره می‌شود.
* text=auto eol=lf

# ── فایل‌هایی که باید *حتماً* LF بمانند (اجرایی‌اند) ──
*.sh    text eol=lf
*.bash  text eol=lf

# ── دودویی: git هرگز نباید محتوایشان را دست بزند ──
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.avif  binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary
*.mp4   binary
*.webm  binary
