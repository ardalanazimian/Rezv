# متغیرهای محیطیِ محیط‌های خاص (‎.env.example استثناست چون به *.env ختم نمی‌شود)
.env.production
.env.development
.env.*.local

# اسنپ‌شاتِ Redis هنگامِ اجرای محلی (در api/ ساخته می‌شود؛ نباید کامیت شود)
dump.rdb

# کشِ پایتونِ ابزارها
tools/__pycache__/

# بسته‌های تولیدشده برای تحویل (از standalone/ و git خودش دوباره ساخته می‌شوند)
/rezervno-website.zip
/rezervno-site.bundle

# خروجیِ افزایشیِ tsc (آرتیفکتِ build، نه منبع)
api/tsconfig.tsbuildinfo
/rezervno-changes.patch
/rezervno-changes.patch.gz

# کپیِ محلیِ تکراری از کل مخزن — به‌اشتباه به‌صورت gitlink (submodule) استیج شده بود
# و چون .gitmodules ندارد، clone/CI را می‌شکست.
RezervnoOSv2/

# فایل‌های موقتِ ابزارهای AI/ادیتور
.copilot-temp/

# توکنِ scrapeِ Prometheus — راز است، مثلِ .env
observability/metrics-token

# درِیلِ بازیابی: رکوردهای JSON شاهدند و commit می‌شوند، ولی خودِ dumpها نه —
# یک dumpِ دیتابیس داده دارد و در مخزن جایش نیست. نتیجه: در یک clone تازه
# گیتِ A1 قرمز است، که درست هم هست: آن ماشین هیچ درِیلی اجرا نکرده.
audit/drills/dumps/

# فیکسچرِ محلیِ بوت‌استرپِ A11: رمزِ عبورِ متن‌ساده دارد، هیچ کدی نمی‌خواندش
# (تنها ارجاعش audit/round-16/A11-logs/bootstrap-platform.mjs:51 است که کنارِ
# خودش می‌نویسد، نه در api/)، و ignore نبود — یک `git add -A` تا کامیت‌شدنِ
# یک credential در پوشه‌ی اپِ تولیدی فاصله داشت.
# پیگیریِ ۲۰۲۶-۰۹-۰۴ (A11-REPORT.md «Credential hygiene»): خودِ نسخه‌ی
# دستی‌جاگذاری‌شده حذف شد (dead code بود، هیچ importی نداشت)؛ رمز دیگر در
# هیچ فایلِ JSONی نوشته نمی‌شود — رمزهای واقعیِ اجراهای بعدی فقط در
# audit/round-16/A11-logs/a11-secrets.env (ignore‌شده در ادامه‌ی همین بخش)
# می‌نشینند. این خط برای دفاعِ لایه‌ی دوم می‌ماند، حتی اگر امروز فایلی
# تولیدش نکند.
api/platform-fixture.json

# رمزهای تولیدشده‌ی اجراهایِ A11 (رمزِ ادمین/مالک، رازِ TOTP) — فقط برایِ
# دیتابیسِ یک‌بارمصرفِ محلی (rezervno_a11)، هیچ ربطی به تولید ندارند، ولی
# متنِ‌سادهاند و نباید تصادفاً commit شوند.
audit/round-16/A11-logs/a11-secrets.env

# پیکربندیِ ادیتور — تولیدیِ خودِ افزونه است، نه سندِ پروژه. موردِ فعلی
# افزونه‌ی Supabase را «توصیه» می‌کند، در حالی که Supabase از مسیرِ بحرانی
# خارج شده و در صفِ decommission است (audit/round-19/supabase-decommission-checklist.md).
.vscode/
