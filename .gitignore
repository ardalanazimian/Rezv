.env.local
*.env

# خروجیِ محلیِ ابزارِ graphify (نگاشتِ کدبیس به knowledge graph) — تولیدی،
# قابلِ‌بازسازی، و نباید به مخزن برود
graphify-out/

node_modules/
api/node_modules/
.next/
api/.next/
*.log
.DS_Store
api/prisma/*.db

# ۲۰۲۶-۰۸-۱۲: Next.js 16 هنگامِ `next dev` خودکار AGENTS.md/CLAUDE.md تولیدی
# می‌سازه (ویژگیِ جدیدِ agent-rules) — این تولیدی‌ست، نه سندِ واقعیِ پروژه؛
# اگه commit بشه با CLAUDE.mdِ واقعیِ ریشه (که این پروژه ازش پیروی می‌کنه)
# اشتباه گرفته می‌شه. اگه لازم شد، فقط حذفش کن؛ دوباره تولید می‌شه.
# ۲۰۲۶-۰۸-۱۹: الگو تعمیم داده شد — تا امروز فقط `api/` را می‌گرفت، ولی هر
# اپِ Next دیگری که `next dev` روی آن اجرا شود همین دو فایل را می‌سازد
# (اولین موردش apps/seo بود). با الگویِ عام دیگر هر بار دستی اضافه نمی‌شود.
api/AGENTS.md
api/CLAUDE.md
apps/*/AGENTS.md
apps/*/CLAUDE.md

# فایل‌هایِ آپلودیِ کاربر (عکسِ گالری و عکسِ آیتم‌هایِ منو).
# مسیرِ پیش‌فرضِ `lib/media-store.ts` است و روی ولوم می‌نشیند، نه در گیت —
# بدونِ این الگو، اولین آپلودِ محلی بی‌صدا واردِ کامیتِ بعدی می‌شد.
api/.uploads/
.uploads/

# بک‌آپ‌های دیتابیس (نباید در git بروند)
backup/data/*.sql.gz
backup/data/*.sql

# ── تکمیل‌شده در آماده‌سازیِ گیت (۲۰۲۶-۰۷-۲۳) ──
