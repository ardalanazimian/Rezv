# ═══════════════════════════════════════════════════════════
#  رزرونو — متغیرهای محیطی
#  کپی کن به .env و پر کن:  cp .env.example .env
#  ⚠️  .env را در git نگذار (در .gitignore هست)
# ═══════════════════════════════════════════════════════════

# ── دیتابیس ──
POSTGRES_USER=rezervno
POSTGRES_PASSWORD=یک_رمز_قوی_بگذار
POSTGRES_DB=rezervno

# ── کلیدهای JWT (تصادفی و بلند بساز: openssl rand -base64 48) ──
JWT_SECRET=یک_کلید_تصادفی_بلند
JWT_REFRESH_SECRET=یک_کلید_تصادفی_دیگر

# ── حالت OTP ──
# true = کد در پاسخ برمی‌گردد (فقط برای تست بدون پیامک واقعی)
# قبل از لانچ واقعی روی false بگذار
OTP_DEV_MODE=true

# کلید مخفی برای endpointهای نگهداری (انقضای هولد رزرو) — یک رشته تصادفی
MAINTENANCE_KEY=change-me-random-string

# ── دامنه‌های مجاز برای صداکردنِ API (CORS + محافظتِ CSRF) ──
# ⚠️ مهم‌ترین متغیرِ لانچ. هر دامنه‌ای که فرانت از آن سرو می‌شود باید اینجا باشد.
# اگر غلط باشد هیچ خطایی نمی‌بینی: مرورگر درخواست‌ها را بلاک می‌کند و اپِ مشتری
# به دادهٔ «نمونه» برمی‌گردد — یعنی همه محتوایِ آزمایشی می‌بینند.
# فرمت دقیقاً scheme://host[:port] است: بدونِ اسلشِ پایانی، بدونِ مسیر، بدونِ «*».
# سرور در production مقدارِ غلط را هم مثلِ مقدارِ خالی رد می‌کند (fail-fast).
ALLOWED_ORIGINS=https://example.ir,https://www.example.ir

# ── محافظتِ /api/metrics ──
# بدونِ این، متریک‌های داخلیِ Prometheus عمومی‌اند. یک رشته‌ی تصادفی بگذار.
METRICS_TOKEN=change-me-random-hex
# رمزِ ادمینِ Grafana — اجباری (`:?` در docker-compose.observability.yml).
# بدونِ آن استکِ رصدپذیری بالا نمی‌آید؛ پیش‌فرضِ `admin` عمداً حذف شد.
GRAFANA_PASSWORD=change-me-strong-password
# آدرسِ عمومیِ Grafana (فقط برایِ لینک‌سازیِ درستِ خودِ Grafana).
GRAFANA_ROOT_URL=http://127.0.0.1:3001

# ── ذخیره‌سازیِ عکسِ گالری ──
# محلِ فایلِ عکس‌هایی که رستوران‌ها آپلود می‌کنند. در docker-compose روی
# ولومِ نام‌دارِ «uploads» سوار می‌شود، پس با بازسازیِ کانتینر پاک نمی‌شود.
# ⚠️ این مسیر را در نسخه‌پشتیبان بگنجان — بایت‌ها در Postgres نیستند و
#    pg_dump آن‌ها را نمی‌گیرد.
# بدونِ تنظیم، در توسعه به .uploads کنارِ پروژه می‌افتد.
UPLOAD_DIR=/data/uploads

# ── seed خودکار ──
# برای اولین راه‌اندازی true بگذار (داده‌ی اولیه: رستوران/مشتری/مدیر)
# بعد از اولین بار، روی false بگذار
RUN_SEED=true

# ── دامنه (فقط برای HTTPS/تولید) ──
# دامنه‌ی پایه. Caddy خودکار برای همه‌ی زیردامنه‌های زیر SSL می‌گیرد.
# فقط وقتی با docker-compose.prod.yml اجرا می‌کنی لازم است.
#
# چیدمانِ زیردامنه (deploy/caddy/Caddyfile — ADR 0002):
#   DOMAIN                → وب‌سایتِ عمومی، روی Vercel. Caddy دستش نمی‌زند.
#   api.DOMAIN            → بک‌اند
#   app.DOMAIN            → اپِ مشتری
#   business.DOMAIN       → پنلِ کسب‌وکار
#   admin.DOMAIN          → پنلِ شرکت
#
# برای هر زیردامنه یک رکوردِ A به آی‌پیِ این سرور بساز. ریشه و www را به
# Vercel اشاره بده، نه به این سرور.
DOMAIN=

# ── مدیر پلتفرم (پنل شرکت) ──
# بعد از اجرای seed، شناسه‌ی tenant شرکت را اینجا بگذار (seed آن را چاپ می‌کند)
PLATFORM_ADMIN_TENANT_ID=

# ── پیامک: ملی‌پیامک (اختیاری — بدون نام‌کاربری/رمز فقط لاگ می‌شود) ──
# مهاجرت از کاوه‌نگار در ۲۰۲۶-۰۸-۲۶.
# API: https://rest.payamak-panel.com/api/SendSMS/{SendSMS|BaseServiceNumber}
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=
#
# خطِ اختصاصی — فقط برایِ پیامکِ **متنِ آزاد** (کمپین) لازم است.
# بدونِ آن، ارسالِ متنِ آزاد صریح شکست می‌خورد (و «ارسال شد» نمی‌گوید).
MELIPAYAMAK_FROM=
#
# ⚠️ برخلافِ کاوه‌نگار که الگو را با **نام** صدا می‌زد، ملی‌پیامک با
# **شناسه‌ی عددیِ** الگو (bodyId) کار می‌کند که بعد از تأییدِ متن در پنل
# صادر می‌شود. پس این‌ها پیش‌فرض ندارند — هر کدام خالی بماند، همان نوع
# پیامک ارسال **نمی‌شود** (و در لاگ صریح گزارش می‌شود، بی‌صدا رد نمی‌شود).
MELIPAYAMAK_BODYID_OTP=
MELIPAYAMAK_BODYID_BOOKING=
MELIPAYAMAK_BODYID_REMINDER=
MELIPAYAMAK_BODYID_WELCOME=
MELIPAYAMAK_BODYID_CAMPAIGN=
MELIPAYAMAK_BODYID_WINBACK=
# الگوهای چرخه‌ی حیات رزرو (در پنلِ ملی‌پیامک تعریف و تأیید کن)
MELIPAYAMAK_BODYID_PREPARING=
MELIPAYAMAK_BODYID_REJECTED=
MELIPAYAMAK_BODYID_CANCELLED=
MELIPAYAMAK_BODYID_NOSHOW=
MELIPAYAMAK_BODYID_THANKS=
#
# جداکننده‌ی مقادیرِ توکن در سرویسِ الگو. پیش‌فرض `;`.
# ⚠️ راستی‌آزمایی‌نشده — ملی‌پیامک عمومی مستندش نکرده. از پنلِ خودت تأیید کن.
MELIPAYAMAK_TOKEN_SEPARATOR=;

# ═══════════════════════════════════════════════════════════
#  بک‌آپ خودکار دیتابیس
# ═══════════════════════════════════════════════════════════
# زمان‌بندی cron (پیش‌فرض: هر روز ۳ بامداد). نمونه‌ها:
#   0 3 * * *     هر روز ۳ بامداد
#   0 */6 * * *   هر ۶ ساعت
#   0 3 * * 0     هر یکشنبه ۳ بامداد
BACKUP_CRON=0 3 * * *

# چند بک‌آپ آخر نگه داشته شود (بقیه خودکار حذف می‌شوند)
BACKUP_KEEP=14

# بک‌آپ فوری هنگام بالا آمدن (پیشنهاد: true)
BACKUP_ON_START=true

# ── آپلود بک‌آپ به آبجکت‌استوریج (اختیاری ولی مهم) ──
# بک‌آپی که فقط روی همان سرور است، با از‌دست‌رفتن سرور می‌رود.
# آبجکت‌استوریج S3-compatible: آروان، لیارا، یا AWS S3
# اگر خالی بگذاری، فقط بک‌آپ محلی گرفته می‌شود.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── اعلان Push (Firebase) و Email — اختیاری، برای لیست انتظار ──
FCM_SERVER_KEY=
EMAIL_API_KEY=
EMAIL_FROM=noreply@rezervno.ir

# الگوهای SMS لیست انتظار (bodyIdِ ملی‌پیامک)
MELIPAYAMAK_BODYID_WAITLIST=
MELIPAYAMAK_BODYID_WL_JOIN=
MELIPAYAMAK_BODYID_WL_OFFER=
# SPEC-B — الگویِ دعوتِ اولین‌ورودِ owner (سه توکن: نامِ مالک، نامِ رستوران، لینک)
MELIPAYAMAK_BODYID_INVITE=
# پایه‌ی لینکِ دعوت در پیامک (بدونِ اسلشِ انتهایی)؛ پیش‌فرضِ کد: https://rezervno.ir
INVITE_BASE_URL=

# ── امنیت: منشأهای مجاز (CSRF defense) — دامنه‌های فرانت، با کاما جدا ──
#
# باید هر مبدأیی که به API درخواستِ mutating می‌زند اینجا باشد. توجه: پنل‌ها
# API را same-origin صدا می‌زنند (Caddy روی هر زیردامنه /api/* را پروکسی می‌کند)
# ولی این معاف‌شان نمی‌کند — مرورگر روی POST/PATCH/DELETE حتی same-origin هم
# هدرِ Origin می‌فرستد و middleware هر Originِ خارج از فهرست را ۴۰۳ می‌کند.
ALLOWED_ORIGINS=https://rezervno.ir,https://www.rezervno.ir,https://app.rezervno.ir,https://business.rezervno.ir,https://admin.rezervno.ir

# ═══════════════════════════════════════════════════════════
#  وب‌سایتِ عمومی (apps/landing) — ADR 0002
# ═══════════════════════════════════════════════════════════
# گیرنده‌ی اعلانِ درخواستِ خرید/دمو و پیامِ تماس با فروش.
# می‌توان به‌جای این، کلیدِ sales_notify_email را از پنلِ شرکت تنظیم کرد
# (تنظیمِ دیتابیس بر env اولویت دارد و بدونِ ری‌دیپلوی عوض می‌شود).
SALES_NOTIFY_EMAIL=

# ── متغیرهای خودِ اپِ apps/landing (در پروژه‌ی Vercelِ آن تنظیم می‌شوند) ──
# NEXT_PUBLIC_SITE_URL=https://rezervno.ir        # دامنه‌ی همین سایت (canonical و sitemap)
# NEXT_PUBLIC_SITE_URL همچنین دامنه‌ای است که داخلِ QRِ منو چاپ می‌شود — در
# staging حتماً ست کن، وگرنه QRِ محیطِ تست به دامنه‌ی تولید اشاره می‌کند.

# فقط اگر اپِ SEO و API روی یک دامنه نباشند: دامنه‌ای که مرورگرِ کاربر باید
# عکسِ آیتم‌های منو را از آن بگیرد. عمداً از SEO_API_BASE جداست، چون آن یکی
# ممکن است آدرسِ داخلیِ داکر باشد که مرورگر به آن نمی‌رسد.
# NEXT_PUBLIC_MEDIA_BASE=https://api.rezervno.ir
# SITE_API_BASE=https://api.rezervno.ir           # سمتِ سرور: خواندنِ محتوا و sitemap
# NEXT_PUBLIC_API_BASE=https://api.rezervno.ir    # سمتِ مرورگر: فرم‌ها و داشبورد
# NEXT_PUBLIC_CUSTOMER_APP_URL=https://app.rezervno.ir
# NEXT_PUBLIC_BUSINESS_APP_URL=https://business.rezervno.ir
# NEXT_PUBLIC_COMPANY_APP_URL=https://admin.rezervno.ir
#
# ⚠️ دامنه‌ی وب‌سایت حتماً باید در ALLOWED_ORIGINS بالا باشد،
#    وگرنه فرمِ دمو/خرید/تماس با خطای CORS رد می‌شود.

# ── اپِ صفحاتِ رستوران (apps/seo) — پروژه‌ی Vercelِ جداگانه، ADR 0001 ──
# این اپ دست‌نخورده است و دامنه‌ی خودش را دارد. دو اپ نباید روی یک دامنه
# بنشینند، وگرنه canonicalهای متناقض تولید می‌شود.
# SEO_API_BASE=https://api.rezervno.ir

# ── ورودِ سه‌عاملیِ مدیرِ پلتفرم (TOTP — RFC 6238) ──
# ⚠️ این «ورود با گوگل» نیست: کاملاً آفلاین است و هیچ ارتباطی با
# accounts.google.com ندارد. فقط یک رازِ مشترک و ساعتِ سیستم.
#
# پیش‌فرض **خاموش**. با خاموش‌بودن، ورودِ دوعاملیِ فعلی (نام کاربری + رمز)
# دقیقاً مثلِ امروز کار می‌کند و فیلدِ سومِ فرم اصلاً رندر نمی‌شود.
#
# ⚠️ اگر روشن باشد ولی USERNAME/SECRET ست نشده باشند، ورود **ممنوع** می‌شود
# (fail-closed) — نه بازگشتِ بی‌صدا به دو عاملی.
#
# ساخت با:  node tools/admin-totp-secret.mjs <username>
ADMIN_LOGIN_ENABLED=false
ADMIN_TOTP_USERNAME=
ADMIN_TOTP_SECRET=
