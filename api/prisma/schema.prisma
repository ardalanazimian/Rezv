generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id            String       @id @default(uuid()) @db.Uuid
  name          String
  plan          SubscriptionPlan @default(free)
  planExpiresAt DateTime?    @map("plan_expires_at")
  trialEndsAt   DateTime?    @map("trial_ends_at")
  version       Int          @default(1)   // Optimistic Lock — جلوگیری از Lost Update در ویرایشِ همزمان
  createdAt     DateTime     @default(now()) @map("created_at")
  restaurants   Restaurant[]
  staff         Staff[]
  @@map("tenants")
}

// پلنِ اشتراک — enum به‌جای String: از ورودِ 'Pro'/'PRO'/فاصله جلوگیری می‌کند
enum SubscriptionPlan {
  free
  starter
  pro
  enterprise

  @@map("subscription_plan")
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  phone        String        @unique
  email        String?       @unique                            // اختیاری؛ برای آینده: ورود ایمیلی، رسید، مارکتینگ
  firstName    String?       @map("first_name")
  lastName     String?       @map("last_name")
  birthDate    DateTime?     @map("birth_date") @db.Date
  anniversaryDate DateTime?  @map("anniversary_date") @db.Date  // سالگرد (برای پاداش)
  referralCode String?       @unique @map("referral_code")       // کد دعوت یکتای کاربر
  referredById String?       @map("referred_by_id") @db.Uuid     // چه کسی این کاربر را دعوت کرد
  avatarUrl    String?       @map("avatar_url")
  // ترجیحاتِ اعلان به‌ازای دسته (migration 050). کلیدِ غایب = کاربر نظری نداده
  // (پیش‌فرضِ دریافت)؛ فقط `false`ِ صریح یعنی انصراف. jsonb نه پنج ستونِ boolean،
  // چون مجموعه‌ی دسته‌ها یک تصمیمِ محصولی است و با هر تغییر migration نمی‌خواهد.
  notificationPrefs Json     @default("{}") @map("notification_prefs")
  createdAt    DateTime      @default(now()) @map("created_at")
  // ── بن سختِ پلتفرم (migration 039) — کاملاً جدا از hasActiveAbuseFlagِ نرم ──
  // «الان بن است» = bannedAt ست شده و unbannedAt نال است. بن‌شدنِ دوباره بعد
  // از رفعِ بن، banned_at/banned_reason را بازنویسی می‌کند (unbanned_at ریست
  // به null)؛ تاریخچه‌ی کامل در audit_logs (user.ban/user.unban) می‌ماند —
  // این ستون‌ها فقط وضعیتِ *فعلی* را نشان می‌دهند، نه کل تاریخچه.
  bannedAt        DateTime? @map("banned_at")
  bannedReason    String?   @map("banned_reason")
  bannedByAdminId String?   @map("banned_by_admin_id") @db.Uuid  // فقط شناسه (بدونِ relationِ Prisma) — هم‌راستا با referredById
  unbannedAt      DateTime? @map("unbanned_at")
  unbanReason     String?   @map("unban_reason")
  reservations Reservation[]
  memberships  ClubMember[]
  waitlistEntries WaitlistEntry[]
  pointsLedger PointsLedger[]
  referrals    Referral[]    @relation("Referrer")
  giftCardsPurchased GiftCard[] @relation("GiftBuyer")
  customerInsights CustomerInsight[]
  reviews      Review[]
  // ⚠️ همگام‌سازی‌شده با DB زنده (migration 022_audit_fixes_2026_07_19):
  guestProfile GuestProfile?
  pushSubscription PushSubscription?
  // ── اقتصادِ یکپارچه‌ی مشتری (migration 038) — رجوع کن به CustomerEconomyProfile ──
  economyProfile    CustomerEconomyProfile?
  economyLedger     EconomyLedgerEntry[]
  missionProgress   MissionProgress[]
  rewardRedemptions RewardRedemption[]
  // ── نشان‌هایِ کنترل‌شده‌یِ پلتفرم (migration 040) — جدا از BADGES قدیمیِ اپِ کاستومر ──
  badges            UserBadge[]
  // دفترِ ارتباط‌گیری (migration 057) — تماس/پیامکِ بازاریابی که به این کاربر رفت
  outreachLog       OutreachLog[]
  @@index([createdAt])
  chatThreads  ChatThread[]
  @@map("users")
}

model Staff {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  phone    String
  // نامِ نمایشیِ کارمند (اختیاری) — پنلِ بیزنس آن را نشان/ویرایش می‌کند (migration 027).
  name     String?
  role     StaffRole @default(staff)
  isActive Boolean @default(true) @map("is_active")  // غیرفعال‌سازی کارمند (اخراج) — توکن refreshش رد می‌شود
  permission StaffPermission?
  // ⚠️ همگام‌سازی‌شده با DB زنده (migration 018_staff_branch_scoping):
  // NULL = دسترسی به همه‌ی شعبه‌های تنانت (owner/manager)؛ ست‌شده = قفل به یک شعبه.
  restaurantId String? @map("restaurant_id") @db.Uuid
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id])
  @@unique([tenantId, phone])
  // drift-fix (فازِ ۲، §۲۴): در DB وجود دارد، در schema اعلام نشده بود.
  @@index([restaurantId])
  @@map("staff")
}

model Restaurant {
  id            String           @id @default(uuid()) @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  tenant        Tenant           @relation(fields: [tenantId], references: [id])
  slug          String           @unique
  name          String
  cuisine       String?
  vibes         String[]         @default([])
  priceBand     Int              @default(2) @map("price_band") @db.SmallInt
  isOpen        Boolean          @default(true) @map("is_open")
  openingHours  Json?            @map("opening_hours")  // ساعت کاری هفتگی؛ null=همیشه باز طبق isOpen (سازگاری با گذشته)
  // ── تأییدِ ساعتِ کاری (Part 3، migration 045) — دقیقاً مثلِ RestaurantPhoto.status
  //    ولی روی خودِ رستوران چون هر رستوران حداکثر یک پیشنهادِ درِ دستِ بررسی دارد.
  //    openingHours بالا همیشه «زنده»/تأییدشده است؛ مشتری فقط همان را می‌بیند. ──
  pendingOpeningHours Json?      @map("pending_opening_hours")  // پیشنهادِ رستوران، هنوز تأییدنشده
  hoursChangeStatus   String?   @map("hours_change_status")     // 'pending' | 'rejected' | null
  hoursChangeReason   String?   @map("hours_change_reason")     // دلیلِ رد (برایِ رستوران‌دار)
  hoursChangeRequestedAt DateTime? @map("hours_change_requested_at")
  hoursChangeReviewedAt  DateTime? @map("hours_change_reviewed_at")
  hoursChangeReviewedBy  String?   @map("hours_change_reviewed_by") @db.Uuid
  pricingRules  Json?            @map("pricing_rules")  // قواعدِ حداقل مبلغ رزرو بر اساس شلوغی (AI Pricing)
  baseMinSpendToman Int          @default(0) @map("base_min_spend_toman") // حداقل مبلغِ پایه
  // ── اتصال (heartbeat): برای پنهان‌کردن خودکار رستوران آفلاین از اپ مشتری ──
  lastSeenAt    DateTime?        @map("last_seen_at")   // آخرین heartbeat از پنل بیزنس
  onlineGating  Boolean          @default(true) @map("online_gating") // آیا رزرو آنلاین وابسته به آنلاین‌بودن است
  // ── پیکربندی زمان‌بندی رزرو (با پیش‌فرض امن — API نمی‌شکند) ──
  slotMinutes      Int @default(90) @map("slot_minutes") @db.SmallInt   // مدت پیش‌فرض هر رزرو
  bufferMinutes    Int @default(0)  @map("buffer_minutes") @db.SmallInt  // فاصله‌ی ایمنی بین رزروهای یک میز
  cleaningMinutes  Int @default(15) @map("cleaning_minutes") @db.SmallInt // زمان نظافت/چیدن میز
  lateGraceMinutes Int @default(15) @map("late_grace_minutes") @db.SmallInt // مهلت تأخیر مهمان قبل از no_show
  holdMinutes      Int @default(10) @map("hold_minutes") @db.SmallInt    // مدت هولد رزرو pending تا انقضا
  timezone      String           @default("Asia/Tehran")
  // ── دادهٔ مکانی برای Local/Restaurant SEO (ADR 0001, migration 030) — همه nullable،
  //    backward-compatible؛ منبعِ schema.org PostalAddress + GeoCoordinates در apps/seo. ──
  address       String?
  city          String?
  district      String?
  postalCode    String?          @map("postal_code")
  country       String           @default("IR")
  latitude      Float?
  longitude     Float?
  clubPrefix    String           @map("club_prefix")
  cbBasePct     Int              @default(5) @map("cb_base_pct") @db.SmallInt
  cbPreorderPct Int              @default(8) @map("cb_preorder_pct") @db.SmallInt
  cbVipPct      Int              @default(12) @map("cb_vip_pct") @db.SmallInt
  cbWinbackPct  Int              @default(20) @map("cb_winback_pct") @db.SmallInt
  smsBalance    Int              @default(50) @map("sms_balance")       // موجودی پیامک باقی‌مانده
  smsTotalSent  Int              @default(0) @map("sms_total_sent")    // کل پیامک ارسالی (آمار)
  // ⚠️ همگام‌سازی‌شده با DB زنده (migration 019/020 روی Supabase project zmyuvtpbchytqvtgyewt):
  // این فیلد و بقیه‌ی موارد مشابه («⚠️ همگام‌سازی‌شده») از قبل روی DB بودند ولی هرگز
  // در این schema.prisma منعکس نشده بودند (drift بین DB و ریپو — کشف‌شده و رفع‌شده).
  paymentEnabled Boolean         @default(false) @map("payment_enabled") // فعال/غیرفعال‌بودن پرداخت آنلاین این رستوران
  createdAt     DateTime         @default(now()) @map("created_at")
  tables        Table[]
  menuItems     MenuItem[]
  reservations  Reservation[]
  members       ClubMember[]
  reviews       Review[]
  photos        RestaurantPhoto[]
  staffNotes    StaffNote[]
  campaignLogs  CampaignLog[]
  waitlist      WaitlistEntry[]
  specialEvents SpecialEvent[]
  codeCounter   ClubCodeCounter?
  customerInsights CustomerInsight[]
  coupons       Coupon[]
  marketingAutomations MarketingAutomation[]
  staff         Staff[] // ⚠️ همگام‌سازی‌شده: چندشعبه‌ای — کارمندانِ قفل‌شده به این شعبه
  // ⚠️ همگام‌سازی‌شده با DB زنده (migration 022_audit_fixes_2026_07_19) — بک‌رفرنس‌های
  // FKهایی که تازه اضافه شدند:
  webhooks         Webhook[]
  smsTransactions  SmsTransaction[]
  closures         RestaurantClosure[]
  noShowModel      RestaurantNoShowModel?
  demandForecast   RestaurantDemandForecast?
  modelTrainingRuns ModelTrainingRun[]
  // ── دستیارِ هوشمندِ رستوران (migration 050) ──
  assistantVocab        RestaurantAssistantVocab[]
  assistantLogs         RestaurantAssistantLog[]
  // ── اقتصادِ یکپارچه‌ی مشتری (migration 038) ──
  cancellationPolicy    CancellationPolicy?
  economyLedgerEntries  EconomyLedgerEntry[]
  missions              Mission[]
  rewardMarketplaceItems RewardMarketplaceItem[]
  // ── شخصی‌سازیِ صفحه‌ی منویِ عمومی (مهاجرتِ ۰۵۳) ──
  // همه nullable: NULL یعنی «رستوران‌دار انتخاب نکرده» و صفحه به پیش‌فرضِ
  // پلتفرم برمی‌گردد — نه یک مقدارِ جعلیِ ازپیش‌نشسته.
  /// رنگِ تأکیدِ برند به شکلِ #RRGGBB (قیدِ CHECK در دیتابیس).
  menuAccent   String?  @map("menu_accent")
  /// light | dark | auto (قیدِ CHECK در دیتابیس).
  menuTheme    String?  @map("menu_theme")
  /// یک خطِ معرفی زیرِ نامِ رستوران در صفحه‌ی منو.
  menuTagline  String?  @map("menu_tagline")
  /// list | grid — شبکه برایِ منویِ عکس‌محور (قیدِ CHECK در دیتابیس).
  menuLayout   String?  @map("menu_layout")

  @@index([tenantId])
  @@index([city], map: "idx_restaurants_city")
  chatThreads  ChatThread[]
  @@map("restaurants")
  modelPredictions ModelPrediction[]
  outreachLog      OutreachLog[]
}

// ── شکل میز (برای نقشه‌ی بصری و چیدمان) ──
enum TableShape {
  rectangle
  round
  booth                    // اتاقک/کابین
  @@map("table_shape")
}

// ── ناحیه‌ی میز (موقعیت اصلی) ──
enum TableZone {
  indoor                   // داخل سالن
  outdoor                  // فضای باز/حیاط
  window                   // کنار پنجره
  vip                      // بخش ویژه
  smoking                  // بخش سیگار
  @@map("table_zone")
}

// ── وضعیت لحظه‌ای میز (real-time) ──
enum TableState {
  free                     // آزاد
  reserved                 // رزروشده
  occupied                 // اشغال (مهمان نشسته)
  cleaning                 // در حال نظافت
  maintenance              // خارج از سرویس (تعمیر)
  @@map("table_state")
}

model Table {
  id           String        @id @default(uuid()) @db.Uuid
  restaurantId String        @map("restaurant_id") @db.Uuid
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id])
  number       Int           @db.SmallInt
  name         String?       // نام دلخواه میز (مثلاً «میز شاه‌نشین») — اختیاری
  capacity     Int           @db.SmallInt
  // ── محدوده‌ی ظرفیت (نیاز: Min/Max Party Size) ──
  minPartySize Int           @default(1) @map("min_party_size") @db.SmallInt
  maxPartySize Int?          @map("max_party_size") @db.SmallInt // پیش‌فرض = capacity اگر null
  // ── شکل و ناحیه (نیاز: Shape, VIP, Outdoor, Window, Smoking) ──
  shape        TableShape    @default(rectangle)
  zone         TableZone     @default(indoor)
  isVip        Boolean       @default(false) @map("is_vip")
  isSmoking    Boolean       @default(false) @map("is_smoking")
  isAccessible Boolean       @default(false) @map("is_accessible") // دسترس‌پذیر ویلچر
  // ── ترکیب/تقسیم (نیاز: Mergeable, Splittable) ──
  isMergeable  Boolean       @default(false) @map("is_mergeable")
  mergeableWith Int[]        @default([]) @map("mergeable_with") @db.SmallInt // شماره میزهای قابل‌ترکیب
  isSplittable Boolean       @default(false) @map("is_splittable")
  // ── چیدمان بصری (نیاز: Priority, Rotation) ──
  priority     Int           @default(0) @db.SmallInt // اولویت در تخصیص هوشمند (بالاتر = ترجیح بیشتر)
  posX         Int?          @map("pos_x") @db.SmallInt // مختصات روی نقشه‌ی سالن
  posY         Int?          @map("pos_y") @db.SmallInt
  rotation     Int           @default(0) @db.SmallInt // چرخش (درجه) روی نقشه
  // ── محدودیت زمانی (نیاز: Maximum Duration) ──
  maxDurationMinutes Int?    @map("max_duration_minutes") @db.SmallInt // سقف مدت رزرو این میز
  // ── وضعیت لحظه‌ای (نیاز: Cleaning/Occupied/Reserved/Maintenance) ──
  state        TableState    @default(free)
  isActive     Boolean       @default(true) @map("is_active") // میز در دسترس رزرو است؟
  // ── کد QR برای check-in سر میز (نیاز: QR Code) ──
  qrCode       String?       @unique @map("qr_code")
  attributes   String[]      @default([]) // ویژگی‌های آزاد اضافی
  reservations Reservation[]
  @@unique([restaurantId, number])
  @@index([restaurantId, isActive, capacity])
  @@index([restaurantId, state])
  @@index([restaurantId, zone])
  @@map("tables")
}

model MenuItem {
  id           String            @id @default(uuid()) @db.Uuid
  restaurantId String            @map("restaurant_id") @db.Uuid
  restaurant   Restaurant        @relation(fields: [restaurantId], references: [id])
  name         String
  emoji        String?
  priceToman   Int               @map("price_toman")
  isActive     Boolean           @default(true) @map("is_active")
  // توضیحِ کوتاهِ آیتم برایِ منویِ عمومی/QR. NULL = رستوران‌دار ننوشته.
  description  String?
  /// آدرسِ سروِ عکسِ آیتم. از مهاجرتِ ۰۵۳ این مقدار را **سرور** می‌نویسد
  /// (`/api/v1/media/<key>`) و کلاینت نمی‌تواند آدرسِ دلخواه بگذارد.
  /// NULL = آیتم عکس ندارد.
  imageUrl        String?        @map("image_url")
  // ── فایلِ عکسِ آپلودشده (هم‌الگو با RestaurantPhoto) ──
  imageStorageKey String?        @map("image_storage_key")
  imageMime       String?        @map("image_mime")
  imageWidth      Int?           @map("image_width")
  imageHeight     Int?           @map("image_height")
  imageByteSize   Int?           @map("image_byte_size")
  // ترتیبِ دلخواهِ نمایش در منو. کوچک‌تر = بالاتر؛ مساوی‌ها با نام مرتب می‌شوند.
  // عمداً جدا از soldCount: آن یکی آمارِ فروش است، این یکی خواستِ رستوران‌دار.
  sortOrder    Int               @default(0) @map("sort_order")
  soldCount    Int               @default(0) @map("sold_count")
  // دسته‌بندیِ منو (پیش‌غذا/اصلی/دسر/نوشیدنی/…). NULL = دسته‌بندی‌نشده.
  category     String?
  inOrders     ReservationItem[]
  // کوئری منو: آیتم‌های فعال یک رستوران
  @@index([restaurantId, isActive])
  // کوئریِ منویِ عمومی: فعال‌هایِ یک رستوران به ترتیبِ نمایش (مهاجرتِ ۰۵۲).
  // [merge ۰۸-۲۴] map: تا نامِ Prisma = نامِ SQL — وگرنه bootstrapِ db push یک ایندکسِ دومِ هم‌تعریف می‌سازد (نوشتنِ دوبرابر). گاردش: schema-drift.integration.test.mts
  @@index([restaurantId, isActive, sortOrder, name], map: "menu_items_public_order_idx")
  // مهاجرتِ ۰۴۷ — پنل: آیتم‌ها به‌ترتیبِ دسته (قبلاً فقط در SQL بود و db push حذفش می‌خواست)
  @@index([restaurantId, category], map: "menu_items_restaurant_category_idx")
  @@map("menu_items")
}

enum ReservationStatus {
  // ── چرخه‌ی حیات کامل رزرو ──
  pending                  // در انتظار تأیید (هولد موقت)
  waitlisted               // در لیست انتظار (ظرفیت پر بود)
  confirmed                // تأییدشده (دستی توسط رستوران/مشتری)
  auto_confirmed           // تأیید خودکار (سیستم)
  preparing                // در حال آماده‌سازی میز (نزدیک زمان رزرو)
  checked_in               // مهمان رسیده و check-in کرده
  running_late             // مهمان دیر کرده (از زمان گذشته، هنوز نرسیده)
  seated                   // سر میز نشسته
  dining                   // در حال صرف غذا
  completed                // تمام‌شده (مهمان رفت)
  no_show                  // مهمان نیامد
  rejected                 // ردشده توسط رستوران (قبل از تأیید)
  expired                  // هولد منقضی شد
  cancelled                // لغوشده (کلی)
  auto_cancelled           // لغو خودکار (سیستم — مثلاً waitlist که جا باز نشد)
  // ── وضعیت‌های قدیمی (حفظ‌شده برای سازگاری داده‌ی موجود) ──
  arrived                  // [قدیمی] معادل checked_in
  cancelled_by_user        // [قدیمی] معادل cancelled (توسط مشتری)
  cancelled_by_restaurant  // [قدیمی] معادل cancelled (توسط رستوران)
  @@map("reservation_status")
}

// ⚠️ همگام‌سازی‌شده با DB زنده (migration 019_payments_deposit):
enum DepositStatus {
  none      // بیعانه لازم نیست
  pending   // منتظر پرداخت
  paid      // پرداخت‌شده
  refunded  // برگشت‌داده‌شده (لغو رزرو بعد از پرداخت)
  failed    // پرداخت ناموفق
  @@map("deposit_status")
}

// ⚠️ همگام‌سازی‌شده با DB زنده (migration 019_payments_deposit):
enum PaymentStatus {
  pending   // در انتظار بازگشت از درگاه
  success   // پرداخت موفق و verify‌شده
  failed    // پرداخت ناموفق
  refunded  // برگشت‌داده‌شده
  @@map("payment_status")
}

model Reservation {
  id           String            @id @default(uuid()) @db.Uuid
  code         String            @unique
  restaurantId String            @map("restaurant_id") @db.Uuid
  restaurant   Restaurant        @relation(fields: [restaurantId], references: [id])
  tableId      String?           @map("table_id") @db.Uuid
  table        Table?            @relation(fields: [tableId], references: [id])
  userId       String?           @map("user_id") @db.Uuid
  user         User?             @relation(fields: [userId], references: [id])
  guestName    String?           @map("guest_name")
  guestPhone   String?           @map("guest_phone")
  partySize    Int               @map("party_size") @db.SmallInt
  slotStart    DateTime          @map("slot_start")
  slotEnd      DateTime          @map("slot_end")
  status       ReservationStatus @default(confirmed)
  source       String            @default("app")
  preferences  String[]          @default([])
  note         String?
  cancelReason String?           @map("cancel_reason")
  // ── انقضای هولد: رزرو pending که تا این زمان تأیید نشود، expired می‌شود ──
  holdExpiresAt DateTime?        @map("hold_expires_at")
  // ── میزهای ترکیبی (merge): اگر گروه روی چند میز نشسته، شماره‌ی همه اینجاست ──
  mergedTableNumbers Int[]       @default([]) @map("merged_table_numbers") @db.SmallInt
  // ── مدت واقعی این رزرو (دقیقه) — از پیکربندی رستوران یا override ──
  durationMinutes Int?          @map("duration_minutes") @db.SmallInt
  blockBufferMinutes Int        @default(0) @map("block_buffer_minutes") @db.SmallInt
  // ── ریسک no-show (فاز v2 — هوش مشتری) ──
  noShowRiskScore  Int?         @map("no_show_risk_score") @db.SmallInt
  noShowRiskTier   String?      @map("no_show_risk_tier")
  depositRequested Boolean      @default(false) @map("deposit_requested")
  // ⚠️ همگام‌سازی‌شده با DB زنده (migration 019_payments_deposit):
  depositAmountToman Int?       @map("deposit_amount_toman")
  depositStatus      DepositStatus @default(none) @map("deposit_status")
  createdAt    DateTime          @default(now()) @map("created_at")
  items        ReservationItem[]
  events       ReservationEvent[]
  reviews      Review[]
  payments     Payment[] // ⚠️ همگام‌سازی‌شده: یک رزرو می‌تواند چند تلاش پرداخت داشته باشد
  economyLedgerEntries EconomyLedgerEntry[] // اقتصادِ یکپارچه‌ی مشتری (migration 038)
  // حداکثر یک ردیفِ ارتباط‌گیری می‌تواند این رزرو را «تبدیل» خود بداند (قیدِ UNIQUE در DB)
  outreachConversion   OutreachLog?
  // ── ایندکس‌های بهینه برای ۱۰M+ رزرو (بر اساس الگوی واقعی کوئری) ──
  // داشبورد رستوران: رزروهای یک رستوران در بازه‌ی زمانی با وضعیت
  @@index([restaurantId, status, slotStart])
  // کوئری تداخل میز (موتور رزرو + availability)
  @@index([tableId, status, slotStart, slotEnd])
  // تاریخچه‌ی کاربر: رزروهای یک کاربر، جدیدترین اول
  @@index([userId, slotStart(sort: Desc)])
  // پاکسازی هولدهای منقضی (partial-friendly)
  @@index([status, holdExpiresAt])
  // گزارش‌های زمانی و تحلیل (رزروهای ثبت‌شده در بازه)
  @@index([restaurantId, createdAt])
  @@index([restaurantId, noShowRiskTier, slotStart])
  // migration 049 — فهرستِ رزروِ پنل: بازه‌ی slot_start + ترتیب رویِ همان ستون.
  // ایندکس‌هایِ دیگر یک ستونِ غیرِ بازه‌ای بینِ restaurant_id و slot_start دارند.
  @@index([restaurantId, slotStart], map: "reservations_restaurant_slot_idx")
  chatThreads  ChatThread[]
  @@map("reservations")
}

model ReservationItem {
  reservationId String      @map("reservation_id") @db.Uuid
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  menuItemId    String      @map("menu_item_id") @db.Uuid
  // Restrict: آیتم منویی که در سابقه‌ی سفارش هست نباید حذف شود (یکپارچگی تاریخچه)
  menuItem      MenuItem    @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  qty           Int         @default(1) @db.SmallInt
  @@id([reservationId, menuItemId])
  // برای آمار «پرفروش‌ترین آیتم‌ها»
  @@index([menuItemId])
  @@map("reservation_items")
}

// ── لاگ رویداد رزرو (audit log) — هر تغییر وضعیت اینجا ثبت می‌شود ──
model ReservationEvent {
  id            String      @id @default(uuid()) @db.Uuid
  reservationId String      @map("reservation_id") @db.Uuid
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  fromStatus    ReservationStatus? @map("from_status") // وضعیت قبلی (null برای رویداد اول)
  toStatus      ReservationStatus  @map("to_status")   // وضعیت جدید
  actor         String      @default("system")         // چه کسی: system | customer | staff:{id} | cron
  reason        String?                                // دلیل (اختیاری)
  isAutomatic   Boolean     @default(false) @map("is_automatic") // انتقال خودکار بود؟
  createdAt     DateTime    @default(now()) @map("created_at")
  @@index([reservationId, createdAt])
  @@map("reservation_events")
}

// ── وضعیت ورودی لیست انتظار ──
enum WaitlistStatus {
  waiting                  // در صف انتظار
  offered                  // میز آزاد شد، آفر داده شده (منتظر پاسخ مشتری)
  accepted                 // مشتری آفر را پذیرفت → رزرو ساخته می‌شود
  declined                 // مشتری آفر را رد کرد
  expired                  // مهلت پاسخ به آفر گذشت
  seated                   // مشتری نشست (تکمیل)
  cancelled                // مشتری از صف خارج شد
  no_response              // آفر بدون پاسخ منقضی شد (متفاوت از declined)
  @@map("waitlist_status")
}

model WaitlistEntry {
  id              String         @id @default(uuid()) @db.Uuid
  restaurantId    String         @map("restaurant_id") @db.Uuid
  restaurant      Restaurant     @relation(fields: [restaurantId], references: [id])
  userId          String?        @map("user_id") @db.Uuid
  user            User?          @relation(fields: [userId], references: [id])
  // اطلاعات مهمان (برای ورودی بدون حساب)
  guestName       String?        @map("guest_name")
  guestPhone      String?        @map("guest_phone")
  guestEmail      String?        @map("guest_email")
  partySize       Int            @map("party_size") @db.SmallInt
  // ── اولویت صف (بالاتر = جلوتر). VIP و باشگاه طلایی امتیاز می‌گیرند ──
  priority        Int            @default(0) @db.SmallInt
  isVip           Boolean        @default(false) @map("is_vip")
  status          WaitlistStatus @default(waiting)
  // ── زمان‌ها ──
  joinedAt        DateTime       @default(now()) @map("joined_at")
  offeredAt       DateTime?      @map("offered_at")        // کِی آفر داده شد
  offerExpiresAt  DateTime?      @map("offer_expires_at")  // مهلت پاسخ (تایمر انقضا)
  respondedAt     DateTime?      @map("responded_at")
  seatedAt        DateTime?      @map("seated_at")
  // ── تخصیص میز هنگام آفر ──
  offeredTableId  String?        @map("offered_table_id") @db.Uuid
  offeredTableNumber Int?        @map("offered_table_number") @db.SmallInt
  // ── تخمین زمان انتظار (دقیقه) — هنگام پیوستن محاسبه و ذخیره می‌شود ──
  estimatedWaitMinutes Int?      @map("estimated_wait_minutes") @db.SmallInt
  // ── کانال‌های اعلان دلخواه ──
  notifySms       Boolean        @default(true) @map("notify_sms")
  notifyPush      Boolean        @default(true) @map("notify_push")
  notifyEmail     Boolean        @default(false) @map("notify_email")
  // رزرو ساخته‌شده پس از accept (در صورت وجود)
  reservationCode String?        @map("reservation_code")
  note            String?
  createdAt       DateTime       @default(now()) @map("created_at")
  // توکنِ دسترسیِ مهمان (رفعِ IDOR، migration 041) — فقط برایِ ورودی‌هایِ
  // بدونِ حساب (userId=null) صادر می‌شه؛ accept/decline/leave روی این ورودی‌ها
  // علاوه‌بر UUID، این توکن رو هم می‌خوان.
  // ⚠️ migration 044: فقط hashِ توکن ذخیره می‌شه (همون الگویِ otp_codes.code_hash
  // در otp.ts) — نه خودِ توکنِ خام. اگر DB لو بره (backup، SQLi، دسترسیِ
  // داخلی)، دیگه نمی‌شه مستقیم از رویِ دیتا guest tokenِ فعال رو استخراج و
  // impersonate کرد. توکنِ خام فقط یک‌بار (لحظه‌ی join) به کلاینت برمی‌گرده.
  guestAccessTokenHash String?    @map("guest_access_token_hash")
  @@index([restaurantId, status, priority(sort: Desc), joinedAt])
  @@index([status, offerExpiresAt])
  @@index([userId, status])
  @@map("waitlist_entries")
}

// ── دفتر امتیاز (تاریخچه‌ی کسب/خرج امتیاز وفاداری) ──
