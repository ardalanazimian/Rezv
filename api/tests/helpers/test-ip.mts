// ═══════════════════════════════════════════════════════════════════════
//  IPِ یکتا برای هر درخواستِ تست
//
//  ⚠️ چرا وجود دارد (شکستِ واقعیِ CI، ۲۰۲۶-۰۸-۲۵ — با بازتولیدِ کنترل‌شده
//  اثبات شد، نه حدس):
//
//  `clientIp()` وقتی هیچ هدرِ IPی نباشد رشته‌ی ثابتِ `'unknown'` برمی‌گرداند
//  (`src/lib/ratelimit.ts`). یعنی **همه‌ی** فایل‌های تستی که `new Request()`
//  بدونِ هدر می‌سازند، در یک کلیدِ مشترکِ Redis جمع می‌شوند: `rl:auth:unknown`.
//  سقفِ سطحِ `auth` هم ۲۰ درخواست در ۶۰ ثانیه است.
//
//  نتیجه: هر بار که یک روتِ تازه به سطحِ `auth` منتقل شود، سطلِ مشترک
//  زودتر پر می‌شود و **یک تستِ کاملاً بی‌ربط** ۴۲۹ می‌گیرد. دقیقاً همین رخ
//  داد: بعد از انتقالِ دو روتِ دستیار از `search` به `auth`، تستِ
//  «تلفنِ نامعتبر → ۴۲۲» در `member-create` با ۴۲۹ قرمز شد.
//
//  بازتولیدِ کنترل‌شده (هر دو حالت اجرا شد):
//    سطلِ `rl:auth:unknown` را با ۲۵ عضو پر کن، سپس
//      • بدونِ IPِ یکتا → تست‌ها ۴۲۹ می‌گیرند
//      • با IPِ یکتا    → ۵/۵ سبز
//
//  ⚠️ چرا راهِ حل «پاک‌کردنِ کلیدهای Redis در before» **نیست**: آن کار سطلِ
//  فایل‌های دیگرِ همین رانر را هم خالی می‌کند و ریت‌لیمیت را از تستِ آن‌ها
//  پنهان می‌کند — یعنی یک گاردِ امنیتیِ واقعی را از سنجش خارج می‌کند.
//  IPِ یکتا سطل را **جدا** می‌کند، نه خالی: سقفِ واقعیِ روت دست‌نخورده و
//  همچنان قابلِ سنجش می‌ماند.
//
//  استفاده:
//    import { testIp } from './helpers/test-ip.mts';
//    new Request(url, { headers: { 'x-real-ip': testIp(), ... } })
// ═══════════════════════════════════════════════════════════════════════

let seq = 0;

/** IPِ یکتا و پایدار برای هر فراخوانی — سطلِ ریت‌لیمیتِ جدا می‌سازد. */
export function testIp(): string {
  seq += 1;
  return `10.99.${Math.floor(seq / 250) % 250}.${seq % 250}`;
}
