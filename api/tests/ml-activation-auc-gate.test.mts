import { test, describe } from 'node:test';
import assert from 'node:assert/strict';

// ═══════════════════════════════════════════════════════════════════════
//  گیتِ تفکیک در فعال‌سازیِ مدل
//
//  ⚠️ شکافی که این فایل می‌بندد: تا امروز تنها شرطِ کیفیِ فعال‌سازی این بود
//  که Brierِ مدل **۵٪ بهتر از heuristic** باشد. ولی Brier کالیبراسیون و
//  تفکیک را قاطی می‌کند، و یک مدلِ کاملاً بی‌فایده می‌تواند از آن رد شود:
//
//  اگر نرخِ پایه‌ی no-show مثلاً ۲۰٪ باشد و مدل به **همه** عددِ ۰٫۲ بدهد،
//  Brierش ۰٫۱۶ می‌شود که ممکن است از heuristic بهتر باشد — ولی AUCش دقیقاً
//  ۰٫۵ است: صفر اطلاعات. رستوران‌دار می‌پرسد «با کدام ۱۰ مهمان تماس بگیرم؟»
//  و چنین مدلی جوابی ندارد.
//
//  از امروز `MIN_AUC` جلوی فعال‌شدنِ چنین مدلی را می‌گیرد.
// ═══════════════════════════════════════════════════════════════════════

const { rocAuc, brierScore } = await import('../src/lib/ml-core');
const { MIN_AUC } = await import('../src/lib/no-show-model');

describe('گیتِ AUC — مدلِ بی‌تفکیک نباید فعال شود', () => {

  test('🔴 مدلِ «همه یک عدد» از Brier رد می‌شود ولی AUC می‌گیردش', () => {
    // بازتولیدِ دقیقِ سناریو: نرخِ پایه ۲۰٪، مدل به همه ۰٫۲ می‌دهد.
    const n = 200;
    const labels = Array.from({ length: n }, (_, i) => (i % 5 === 0 ? 1 : 0));
    const constantModel = Array(n).fill(0.2);

    const brier = brierScore(constantModel, labels);
    const auc = rocAuc(constantModel, labels);

    assert.ok(brier <= 0.16 + 1e-9, `Brier «خوب» به‌نظر می‌رسد: ${brier}`);
    assert.equal(auc, 0.5, 'ولی تفکیکش دقیقاً صفر است');
    assert.ok(auc! < MIN_AUC, `و باید زیرِ کفِ ${MIN_AUC} بیفتد ⇒ فعال نشود`);
  });

  test('کنترلِ منفی: مدلِ واقعاً تفکیک‌کننده از گیت رد می‌شود', () => {
    // بدونِ این، «همیشه رد کن» هم سبز می‌شد و هیچ مدلی هرگز فعال نمی‌شد.
    const n = 200;
    const labels: number[] = []; const preds: number[] = [];
    for (let i = 0; i < n; i++) {
      const isNoShow = i % 5 === 0;
      labels.push(isNoShow ? 1 : 0);
      preds.push(isNoShow ? 0.55 + (i % 7) / 50 : 0.10 + (i % 7) / 50);
    }
    const auc = rocAuc(preds, labels)!;
    assert.ok(auc >= MIN_AUC, `مدلِ سالم باید رد شود: AUC ${auc} >= ${MIN_AUC}`);
  });

  test('کفِ MIN_AUC محافظه‌کارانه ولی معنادار است', () => {
    // ۰٫۵ = حدسِ تصادفی. کف باید بالاتر از آن باشد وگرنه بی‌معناست؛ و آن‌قدر
    // بالا نباشد که هیچ مدلِ واقعیِ اولیه‌ای رد نشود.
    assert.ok(MIN_AUC > 0.5, 'کف باید از حدسِ تصادفی بالاتر باشد');
    assert.ok(MIN_AUC <= 0.75, 'کفِ خیلی بالا یعنی هیچ مدلی هرگز فعال نمی‌شود');
  });

  test('🔴 تفکیکِ اندازه‌گیری‌نشده ⇒ فعال نشود (نه اینکه صفر فرض شود)', () => {
    // هولدآوتِ تک‌کلاسه: AUC تعریف‌نشده است. قاعده‌ی ML_CONTRACT می‌گوید
    // این «insufficient_data» است نه «بد» — ولی مدلی که نتوانستیم بسنجیمش
    // هم نباید به تولید برود.
    assert.equal(rocAuc([0.2, 0.5, 0.8], [0, 0, 0]), null);
    assert.equal(rocAuc([0.2, 0.5, 0.8], [1, 1, 1]), null);
  });
});
